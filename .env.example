# ── Supabase (obligatorias) ─────────────────────────────────────────
# Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key

# ── Contacto de la landing (opcionales) ─────────────────────────────
# Sin estas, la landing muestra datos de ejemplo.
# Sin prefijo NEXT_PUBLIC_ a propósito: se leen solo en el servidor.
CONTACTO_EMAIL=contacto@tudominio.com
CONTACTO_WHATSAPP=+54 9 11 5555-5555
CONTACTO_TELEFONO=11 5555-5555
CONTACTO_DIRECCION=Florencio Varela 1903
CONTACTO_CIUDAD=San Justo, Buenos Aires
CONTACTO_INSTAGRAM=https://instagram.com/tucuenta
CONTACTO_LINKEDIN=https://linkedin.com/company/tuempresa

# ── Envío de alertas por mail (opcionales) ──────────────────────────
# Con SMTP_USER y SMTP_PASS cargadas, los mails salen solos desde esa casilla.
# Sin ellas, el botón "Mail" abre el cliente de correo con el mensaje escrito.
# SMTP_PASS es la CONTRASEÑA DE APLICACIÓN de Google (16 caracteres),
# nunca la contraseña de la cuenta. Con o sin espacios, da igual.
SMTP_USER=lacasilla@gmail.com
SMTP_PASS=abcd efgh ijkl mnop

# Opcionales: estos son los valores por defecto (Gmail).
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# ALERTAS_FROM_EMAIL=lacasilla@gmail.com


# Copiá este archivo a .env.local (desarrollo) y cargá los mismos valores
# como Environment Variables del proyecto en Vercel (producción).
#
# Los dos valores salen de tu proyecto de Supabase:
# Supabase Dashboard -> Project Settings -> API

# Project URL (ej: https://xxxxxxxxxxxx.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=

# anon / public key (es seguro exponerla en el cliente: el acceso real
# a los datos lo controla Row Level Security en la base)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

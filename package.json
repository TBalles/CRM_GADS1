{
  "name": "crm-gads1",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint src e2e playwright.config.ts scripts/guard playwright.guard.config.ts --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit && tsc --noEmit -p e2e && tsc --noEmit -p scripts/guard",
    "test": "node --test \"src/**/*.check.ts\"",
    "test:e2e": "playwright test",
    "guard": "npm run guard:frozen && npm run guard:landing",
    "guard:frozen": "node scripts/guard/frozen-files.mjs",
    "guard:landing": "playwright test -c playwright.guard.config.ts",
    "guard:baseline-crm": "node scripts/guard/baseline-crm.mjs",
    "manual:capturas": "node scripts/manual/capturas.mjs",
    "manual:pdf": "node scripts/manual/generar.mjs",
    "manual": "npm run manual:capturas && npm run manual:pdf",
    "demo:rubro": "node --env-file-if-exists=.env scripts/demo/cargar-rubro.mjs",
    "migraciones:consolidar": "node scripts/migraciones/consolidar.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.116.0",
    "clsx": "^2.1.1",
    "lucide-react": "^1.47.0",
    "next": "16.3.5",
    "nodemailer": "^7.0.13",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
